// Modelo de datos — Fase 1 (Estudio, RBAC dinámico, empresas, sedes, almacenes, auditoría).
// Todas las tablas de negocio llevan tenant_id y están protegidas con RLS (ver migración rls).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  interno
  cliente
  /// Empleado de una empresa cliente que opera el punto de venta (solo en su empresa)
  operador
}

enum EstadoUsuario {
  pendiente
  activo
  suspendido
}

enum AlcanceTipo {
  estudio
  empresa
  sede
  almacen
}

enum EfectoExcepcion {
  allow
  deny
}

enum TipoTokenUsuario {
  invitacion
  recuperacion
}

enum MetodoValorizacion {
  PEPS
  PROMEDIO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum MotivoMovimiento {
  COMPRA
  DEVOLUCION_CLIENTE
  AJUSTE_POSITIVO
  VENTA
  MERMA
  AJUSTE_NEGATIVO
  ANULACION
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
}

// ───── Punto de venta ─────
enum TipoDocIdentidad {
  SIN_DOCUMENTO
  DNI
  CARNE_EXTRANJERIA
  RUC
  PASAPORTE
}

enum TipoComprobante {
  FACTURA
  BOLETA
  NOTA_VENTA
  NOTA_CREDITO
}

enum EstadoComprobante {
  EMITIDO
  ANULADO
}

/// Envío a SUNAT (fuera de alcance por ahora): los comprobantes electrónicos quedan PENDIENTE
enum EstadoSunat {
  NO_APLICA
  PENDIENTE
  /// Enviado al proveedor; SUNAT aún no responde (p. ej. boletas que van en resumen diario)
  ENVIADO
  ACEPTADO
  /// Aceptado con observaciones (válido)
  OBSERVADO
  RECHAZADO
  /// Comunicación de baja aceptada por SUNAT
  ANULADO
}

enum ModalidadTraslado {
  /// Transporte público: lo hace un transportista (empresa con RUC)
  PUBLICO
  /// Transporte privado: vehículo y conductor propios
  PRIVADO
}

/// Conexión con el SIRE: simulada (pruebas) o la API real de SUNAT
enum ModoSire {
  SIMULADO
  SUNAT
}

/// De qué operación sale un asiento (MANUAL llega en la fase 3C)
enum OrigenAsiento {
  VENTA
  COBRO
  NOTA_CREDITO
  REEMBOLSO
  COBRANZA
  COMPRA
  VENTA_COMERCIAL
  COSTO_VENTA
  MANUAL
  /// Asiento de cierre del ejercicio: salda las cuentas de resultados contra la 89
  CIERRE
}

/// Naturaleza de una cuenta contable: dónde aumenta su saldo
enum NaturalezaCuenta {
  DEUDORA
  ACREEDORA
}

/// Registros del SIRE: ventas e ingresos (RVIE) y compras (RCE)
enum RegistroSire {
  RVIE
  RCE
}

/// Operación asíncrona con SUNAT (por ticket)
enum TipoOperacionSire {
  PROPUESTA
  ACEPTACION
}

enum EstadoOperacionSire {
  PROCESANDO
  TERMINADO
  ERROR
}

/// Diferencia entre la propuesta de SUNAT y lo registrado en el sistema
enum TipoDiferenciaSire {
  SOLO_SUNAT
  SOLO_SISTEMA
  MONTO
  ESTADO
}

enum ResolucionDiferencia {
  PENDIENTE
  ACEPTADA
  JUSTIFICADA
  /// RCE: compra registrada en el sistema que se agrega a la propuesta
  INCLUIDA
  /// RCE: comprobante de la propuesta que se retira del registro (no es gasto del negocio, no se recibió…)
  EXCLUIDA
}

/// Avance de un registro (RVIE o RCE) de un período
enum EstadoRegistroSire {
  PENDIENTE
  PROPUESTA
  CON_DIFERENCIAS
  CONCILIADO
  GENERADO
}

enum ProveedorCpe {
  SIMULADO
  NUBEFACT
}

enum AmbienteCpe {
  PRUEBAS
  PRODUCCION
}

enum FormaPago {
  CONTADO
  CREDITO
}

enum EstadoCobranza {
  VIGENTE
  ANULADA
}

enum MedioPago {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
  TRANSFERENCIA
  OTRO
}

enum EstadoSesionCaja {
  ABIERTA
  CERRADA
}

enum EstadoExportacion {
  PENDIENTE
  PROCESANDO
  LISTO
  ERROR
  EXPIRADO
}

enum TipoDocumentoComercial {
  COMPRA
  VENTA
}

enum EstadoDocumento {
  BORRADOR
  CONFIRMADO
  ANULADO
}

enum Moneda {
  PEN
  USD
}

enum EstadoTransferencia {
  SOLICITADA
  APROBADA
  RECHAZADA
  DESPACHADA
  RECIBIDA
  CANCELADA
}

// ───────────────────────── Estudio (tenant) ─────────────────────────

model Tenant {
  id                 String    @id @default(uuid()) @db.Uuid
  nombre             String
  ruc                String?
  activo             Boolean   @default(true)
  creadoEn           DateTime  @default(now()) @map("creado_en")
  // ── Datos administrados desde la plataforma (Módulo C) ──
  planId             String?   @map("plan_id") @db.Uuid
  emailContacto      String?   @map("email_contacto")
  telefonoContacto   String?   @map("telefono_contacto")
  suspendidoEn       DateTime? @map("suspendido_en")
  motivoSuspension   String?   @map("motivo_suspension")
  /// Módulos contratados aparte del plan (se suman a los del plan)
  modulosAdicionales String[]  @default([]) @map("modulos_adicionales")

  plan     Plan?               @relation(fields: [planId], references: [id])
  facturas FacturaPlataforma[]

  usuarios Usuario[]
  roles    Rol[]
  empresas Empresa[]
  unidades UnidadMedida[]

  @@map("tenants")
}

// ───────────────────────── RBAC ─────────────────────────

/// Catálogo global, sembrado por el sistema. Código: modulo.recurso.accion
model Permiso {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique
  modulo      String
  descripcion String
  sensible    Boolean @default(false)
  /// true para acciones de solo lectura (ver/exportar): únicas permitidas a usuarios cliente
  lectura     Boolean @default(false)
  orden       Int     @default(0)

  roles       RolPermiso[]
  excepciones UsuarioPermisoExcepcion[]

  @@map("permisos")
}

model Rol {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nombre        String
  descripcion   String?
  esSistema     Boolean  @default(false) @map("es_sistema")
  /// Preparado para 2FA obligatorio por rol (Fase 4)
  requiereMfa   Boolean  @default(false) @map("requiere_mfa")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  permisos     RolPermiso[]
  asignaciones UsuarioRol[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
  @@map("roles")
}

model RolPermiso {
  rolId     String @map("rol_id") @db.Uuid
  permisoId String @map("permiso_id") @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@index([tenantId])
  @@map("rol_permisos")
}

model Usuario {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  /// Solo para usuarios tipo cliente: la empresa a la que pertenecen
  empresaId        String?       @map("empresa_id") @db.Uuid
  nombres          String
  documento        String?
  cargo            String?
  telefono         String?
  email            String        @unique
  passwordHash     String?       @map("password_hash")
  tipo             TipoUsuario   @default(interno)
  estado           EstadoUsuario @default(pendiente)
  mfaActivo        Boolean       @default(false) @map("mfa_activo")
  mfaSecret        String?       @map("mfa_secret")
  intentosFallidos Int           @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?     @map("bloqueado_hasta")
  ultimoAcceso     DateTime?     @map("ultimo_acceso")
  creadoEn         DateTime      @default(now()) @map("creado_en")
  actualizadoEn    DateTime      @updatedAt @map("actualizado_en")

  tenant                    Tenant                    @relation(fields: [tenantId], references: [id])
  empresa                   Empresa?                  @relation(fields: [empresaId], references: [id])
  asignaciones              UsuarioRol[]
  excepciones               UsuarioPermisoExcepcion[]
  sesiones                  Sesion[]
  tokens                    TokenUsuario[]
  sedesResponsable          Sede[]
  movimientos               Movimiento[]
  transferenciasSolicitadas Transferencia[]           @relation("Solicitante")
  codigosRecuperacion       MfaCodigoRecuperacion[]

  @@index([tenantId])
  @@map("usuarios")
}

model UsuarioRol {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  usuarioId   String      @map("usuario_id") @db.Uuid
  rolId       String      @map("rol_id") @db.Uuid
  alcanceTipo AlcanceTipo @map("alcance_tipo")
  /// null cuando alcanceTipo = estudio
  alcanceId   String?     @map("alcance_id") @db.Uuid
  creadoEn    DateTime    @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rolId, alcanceTipo, alcanceId])
  @@index([tenantId])
  @@index([alcanceId])
  @@map("usuario_roles")
}

model UsuarioPermisoExcepcion {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  usuarioId   String          @map("usuario_id") @db.Uuid
  permisoId   String          @map("permiso_id") @db.Uuid
  efecto      EfectoExcepcion
  alcanceTipo AlcanceTipo     @map("alcance_tipo")
  alcanceId   String?         @map("alcance_id") @db.Uuid
  creadoEn    DateTime        @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permisoId, alcanceTipo, alcanceId])
  @@index([tenantId])
  @@index([alcanceId])
  @@map("usuario_permisos_excepcion")
}

model Sesion {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  usuarioId        String   @map("usuario_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  dispositivo      String?
  ip               String?
  expiraEn         DateTime @map("expira_en")
  revocada         Boolean  @default(false)
  creadaEn         DateTime @default(now()) @map("creada_en")
  ultimoUso        DateTime @default(now()) @map("ultimo_uso")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tenantId])
  @@map("sesiones")
}

/// Tokens de un solo uso: invitación (activación de cuenta) y recuperación de contraseña
model TokenUsuario {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  usuarioId String           @map("usuario_id") @db.Uuid
  tipo      TipoTokenUsuario
  tokenHash String           @unique @map("token_hash")
  expiraEn  DateTime         @map("expira_en")
  usadoEn   DateTime?        @map("usado_en")
  creadoEn  DateTime         @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tokens_usuario")
}

/// Registro inmutable (trigger en BD bloquea UPDATE/DELETE)
model Auditoria {
  id          BigInt   @id @default(autoincrement())
  tenantId    String   @map("tenant_id") @db.Uuid
  usuarioId   String?  @map("usuario_id") @db.Uuid
  empresaId   String?  @map("empresa_id") @db.Uuid
  modulo      String
  accion      String
  recurso     String
  recursoId   String?  @map("recurso_id")
  antes       Json?
  despues     Json?
  ip          String?
  dispositivo String?
  fecha       DateTime @default(now())

  @@index([tenantId, fecha])
  @@index([tenantId, usuarioId])
  @@index([tenantId, empresaId])
  @@map("auditoria")
}

// ───────────────────────── Organización ─────────────────────────

model Empresa {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  razonSocial         String             @map("razon_social")
  ruc                 String
  contacto            String?
  email               String?
  telefono            String?
  direccion           String?
  metodoValorizacion  MetodoValorizacion @default(PROMEDIO) @map("metodo_valorizacion")
  nombreComercial     String?            @map("nombre_comercial")
  /// Cuenta de detracciones en el Banco de la Nación (se imprime en facturas sujetas al SPOT)
  cuentaDetracciones  String?            @map("cuenta_detracciones")
  /// Buen contribuyente o agente de retención: sus ventas no sufren retención del IGV
  exceptuadoRetencion Boolean            @default(false) @map("exceptuado_retencion")
  /// Buen contribuyente (o UESP): SUNAT le da vencimientos propios en el cronograma mensual
  buenContribuyente   Boolean            @default(false) @map("buen_contribuyente")
  activo              Boolean            @default(true)
  creadoEn            DateTime           @default(now()) @map("creado_en")
  actualizadoEn       DateTime           @updatedAt @map("actualizado_en")

  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  sedes            Sede[]
  almacenes        Almacen[]
  usuarios         Usuario[]
  categorias       Categoria[]
  productos        Producto[]
  movimientos      Movimiento[]
  transferencias   Transferencia[]
  documentos       DocumentoComercial[]
  clientes         Cliente[]
  cajas            Caja[]
  facturacion      ConfigFacturacion?
  comprobantes     Comprobante[]
  cobranzas        Cobranza[]
  guias            GuiaRemision[]
  sire             ConfigSire?
  periodosSire     PeriodoSire[]
  operacionesSire  OperacionSire[]
  propuestasSire   PropuestaSire[]
  cuentaContables  CuentaContable[]
  configContable   ConfigContable?
  asientos         Asiento[]
  periodoContables PeriodoContable[]

  @@unique([tenantId, ruc])
  @@index([tenantId])
  @@map("empresas")
}

model Sede {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  empresaId             String   @map("empresa_id") @db.Uuid
  nombre                String
  direccion             String?
  /// Ubigeo INEI (6 dígitos) y código de establecimiento anexo en SUNAT: puntos de partida/llegada de las guías
  ubigeo                String?
  codigoEstablecimiento String?  @map("codigo_establecimiento")
  responsableId         String?  @map("responsable_id") @db.Uuid
  activo                Boolean  @default(true)
  creadoEn              DateTime @default(now()) @map("creado_en")
  actualizadoEn         DateTime @updatedAt @map("actualizado_en")

  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  responsable Usuario?  @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  almacenes   Almacen[]

  @@unique([empresaId, nombre])
  @@index([tenantId])
  @@map("sedes")
}

model Almacen {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  sedeId        String   @map("sede_id") @db.Uuid
  codigo        String
  nombre        String
  descripcion   String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa               Empresa              @relation(fields: [empresaId], references: [id])
  sede                  Sede                 @relation(fields: [sedeId], references: [id])
  stocks                Stock[]
  movimientos           Movimiento[]
  transferenciasOrigen  Transferencia[]      @relation("Origen")
  transferenciasDestino Transferencia[]      @relation("Destino")
  documentos            DocumentoComercial[]
  cajas                 Caja[]

  @@unique([empresaId, codigo])
  @@index([tenantId])
  @@index([sedeId])
  @@map("almacenes")
}

// ───────────────────────── Catálogos y productos (Fase 2) ─────────────────────────

/// Unidades de medida del estudio (códigos del catálogo 6 de SUNAT)
model UnidadMedida {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  codigo   String
  nombre   String
  activo   Boolean @default(true)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  productos Producto[]

  @@unique([tenantId, codigo])
  @@map("unidades_medida")
}

model Categoria {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  empresaId String @map("empresa_id") @db.Uuid
  nombre    String

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@unique([empresaId, nombre])
  @@index([tenantId])
  @@map("categorias")
}

model Producto {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  categoriaId       String?  @map("categoria_id") @db.Uuid
  unidadId          String   @map("unidad_id") @db.Uuid
  sku               String
  codigoBarras      String?  @map("codigo_barras")
  nombre            String
  descripcion       String?
  /// Precio de venta CON IGV (el que ve el cliente en caja)
  precioReferencial Decimal? @map("precio_referencial") @db.Decimal(14, 4)
  /// Catálogo 07 SUNAT: 10 gravado, 20 exonerado, 30 inafecto
  afectacionIgv     String   @default("10") @map("afectacion_igv")
  /// Bien o servicio sujeto a detracción (catálogo 54 de SUNAT)
  detraccionCodigo  String?  @map("detraccion_codigo")
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now()) @map("creado_en")
  actualizadoEn     DateTime @updatedAt @map("actualizado_en")

  empresa               Empresa                     @relation(fields: [empresaId], references: [id])
  categoria             Categoria?                  @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  unidad                UnidadMedida                @relation(fields: [unidadId], references: [id])
  stocks                Stock[]
  detalles              MovimientoDetalle[]
  transferenciaDetalles TransferenciaDetalle[]
  documentoDetalles     DocumentoComercialDetalle[]
  comprobanteDetalles   ComprobanteDetalle[]

  @@unique([empresaId, sku])
  @@unique([empresaId, codigoBarras])
  @@index([tenantId])
  @@map("productos")
}

// ───────────────────────── Kardex (Fase 2) ─────────────────────────

/// Saldo vigente por almacén y producto (estado mutable, protegido con bloqueo de fila)
model Stock {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  sedeId        String   @map("sede_id") @db.Uuid
  almacenId     String   @map("almacen_id") @db.Uuid
  productoId    String   @map("producto_id") @db.Uuid
  cantidad      Decimal  @default(0) @db.Decimal(18, 4)
  costoPromedio Decimal  @default(0) @map("costo_promedio") @db.Decimal(18, 6)
  valorTotal    Decimal  @default(0) @map("valor_total") @db.Decimal(18, 4)
  stockMinimo   Decimal? @map("stock_minimo") @db.Decimal(18, 4)
  stockMaximo   Decimal? @map("stock_maximo") @db.Decimal(18, 4)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en")

  almacen  Almacen  @relation(fields: [almacenId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([almacenId, productoId])
  @@index([tenantId])
  @@index([empresaId])
  @@map("stocks")
}

/// Capas de costo para PEPS (primeras entradas, primeras salidas)
model CapaCosto {
  id               BigInt   @id @default(autoincrement())
  tenantId         String   @map("tenant_id") @db.Uuid
  almacenId        String   @map("almacen_id") @db.Uuid
  productoId       String   @map("producto_id") @db.Uuid
  /// Línea de kardex (entrada) que originó la capa
  detalleId        BigInt   @unique @map("detalle_id")
  cantidadRestante Decimal  @map("cantidad_restante") @db.Decimal(18, 4)
  costoUnitario    Decimal  @map("costo_unitario") @db.Decimal(18, 6)
  creadoEn         DateTime @default(now()) @map("creado_en")

  @@index([almacenId, productoId, id])
  @@index([tenantId])
  @@map("capas_costo")
}

/// Correlativo de documentos por empresa y tipo (E-000001, S-000001, T-000001)
model Correlativo {
  tenantId  String @map("tenant_id") @db.Uuid
  empresaId String @map("empresa_id") @db.Uuid
  tipo      String
  ultimo    Int    @default(0)

  @@id([empresaId, tipo])
  @@index([tenantId])
  @@map("correlativos")
}

/// Cabecera de movimiento. INMUTABLE (trigger): los errores se corrigen con una anulación inversa.
model Movimiento {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  empresaId          String             @map("empresa_id") @db.Uuid
  sedeId             String             @map("sede_id") @db.Uuid
  almacenId          String             @map("almacen_id") @db.Uuid
  numero             String
  tipo               TipoMovimiento
  motivo             MotivoMovimiento
  metodoValorizacion MetodoValorizacion @map("metodo_valorizacion")
  fecha              DateTime           @default(now())
  fechaDocumento     DateTime?          @map("fecha_documento") @db.Date
  documentoTipo      String?            @map("documento_tipo")
  documentoSerie     String?            @map("documento_serie")
  documentoNumero    String?            @map("documento_numero")
  observacion        String?
  usuarioId          String             @map("usuario_id") @db.Uuid
  /// Movimiento original que esta anulación revierte
  anulaId            String?            @unique @map("anula_id") @db.Uuid
  /// Transferencia que originó el movimiento (despacho o recepción)
  transferenciaId    String?            @map("transferencia_id") @db.Uuid

  empresa            Empresa             @relation(fields: [empresaId], references: [id])
  almacen            Almacen             @relation(fields: [almacenId], references: [id])
  usuario            Usuario             @relation(fields: [usuarioId], references: [id])
  anula              Movimiento?         @relation("Anulacion", fields: [anulaId], references: [id])
  anuladoPor         Movimiento?         @relation("Anulacion")
  transferencia      Transferencia?      @relation(fields: [transferenciaId], references: [id])
  documentoComercial DocumentoComercial? @relation("MovimientoDocumento")
  comprobante        Comprobante?        @relation("MovimientoComprobante")
  detalles           MovimientoDetalle[]

  @@unique([empresaId, numero])
  @@index([tenantId])
  @@index([almacenId, fecha])
  @@map("movimientos")
}

/// Línea del kardex con el saldo resultante. INMUTABLE. El orden del kardex es `id`.
model MovimientoDetalle {
  id                 BigInt  @id @default(autoincrement())
  tenantId           String  @map("tenant_id") @db.Uuid
  movimientoId       String  @map("movimiento_id") @db.Uuid
  almacenId          String  @map("almacen_id") @db.Uuid
  productoId         String  @map("producto_id") @db.Uuid
  cantidad           Decimal @db.Decimal(18, 4)
  costoUnitario      Decimal @map("costo_unitario") @db.Decimal(18, 6)
  costoTotal         Decimal @map("costo_total") @db.Decimal(18, 4)
  saldoCantidad      Decimal @map("saldo_cantidad") @db.Decimal(18, 4)
  saldoCostoUnitario Decimal @map("saldo_costo_unitario") @db.Decimal(18, 6)
  saldoValor         Decimal @map("saldo_valor") @db.Decimal(18, 4)

  movimiento Movimiento @relation(fields: [movimientoId], references: [id])
  producto   Producto   @relation(fields: [productoId], references: [id])

  @@index([almacenId, productoId, id])
  @@index([tenantId])
  @@map("movimiento_detalles")
}

// ───────────────────────── Transferencias (Fase 3) ─────────────────────────

/// Flujo: SOLICITADA → APROBADA → DESPACHADA (salida en origen) → RECIBIDA (entrada en destino).
/// También RECHAZADA o CANCELADA antes del despacho. Cada transición queda en auditoría.
model Transferencia {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  empresaId        String              @map("empresa_id") @db.Uuid
  numero           String
  estado           EstadoTransferencia @default(SOLICITADA)
  origenAlmacenId  String              @map("origen_almacen_id") @db.Uuid
  origenSedeId     String              @map("origen_sede_id") @db.Uuid
  destinoAlmacenId String              @map("destino_almacen_id") @db.Uuid
  destinoSedeId    String              @map("destino_sede_id") @db.Uuid
  observacion      String?
  solicitadoPorId  String              @map("solicitado_por_id") @db.Uuid
  solicitadoEn     DateTime            @default(now()) @map("solicitado_en")
  aprobadoPorId    String?             @map("aprobado_por_id") @db.Uuid
  aprobadoEn       DateTime?           @map("aprobado_en")
  rechazadoPorId   String?             @map("rechazado_por_id") @db.Uuid
  rechazadoEn      DateTime?           @map("rechazado_en")
  despachadoPorId  String?             @map("despachado_por_id") @db.Uuid
  despachadoEn     DateTime?           @map("despachado_en")
  recibidoPorId    String?             @map("recibido_por_id") @db.Uuid
  recibidoEn       DateTime?           @map("recibido_en")
  canceladoPorId   String?             @map("cancelado_por_id") @db.Uuid
  canceladoEn      DateTime?           @map("cancelado_en")
  /// Motivo de rechazo/cancelación u observación de la recepción
  motivoCierre     String?             @map("motivo_cierre")
  actualizadoEn    DateTime            @updatedAt @map("actualizado_en")

  empresa       Empresa                @relation(fields: [empresaId], references: [id])
  origen        Almacen                @relation("Origen", fields: [origenAlmacenId], references: [id])
  destino       Almacen                @relation("Destino", fields: [destinoAlmacenId], references: [id])
  solicitadoPor Usuario                @relation("Solicitante", fields: [solicitadoPorId], references: [id])
  detalles      TransferenciaDetalle[]
  movimientos   Movimiento[]

  @@unique([empresaId, numero])
  @@index([tenantId])
  @@index([origenAlmacenId, estado])
  @@index([destinoAlmacenId, estado])
  @@map("transferencias")
}

model TransferenciaDetalle {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  transferenciaId    String   @map("transferencia_id") @db.Uuid
  productoId         String   @map("producto_id") @db.Uuid
  cantidadSolicitada Decimal  @map("cantidad_solicitada") @db.Decimal(18, 4)
  cantidadDespachada Decimal? @map("cantidad_despachada") @db.Decimal(18, 4)
  cantidadRecibida   Decimal? @map("cantidad_recibida") @db.Decimal(18, 4)
  /// Costo unitario con el que salió del origen (y con el que entra al destino)
  costoUnitario      Decimal? @map("costo_unitario") @db.Decimal(18, 6)

  transferencia Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  producto      Producto      @relation(fields: [productoId], references: [id])

  @@unique([transferenciaId, productoId])
  @@index([tenantId])
  @@map("transferencia_detalles")
}

// ───────────────────────── Fase 4: compras/ventas y 2FA ─────────────────────────

/**
 * Compra o venta. BORRADOR (editable) → CONFIRMADO (genera la entrada/salida de kardex)
 * → ANULADO (registra la anulación inversa del movimiento). Confirmado ya no se edita.
 */
model DocumentoComercial {
  id                     String                 @id @default(uuid()) @db.Uuid
  tenantId               String                 @map("tenant_id") @db.Uuid
  empresaId              String                 @map("empresa_id") @db.Uuid
  sedeId                 String                 @map("sede_id") @db.Uuid
  almacenId              String                 @map("almacen_id") @db.Uuid
  tipo                   TipoDocumentoComercial
  estado                 EstadoDocumento        @default(BORRADOR)
  /// Proveedor (compra) o cliente (venta)
  terceroDocumento       String                 @map("tercero_documento")
  terceroNombre          String                 @map("tercero_nombre")
  comprobanteTipo        String                 @map("comprobante_tipo")
  serie                  String
  numero                 String
  fechaEmision           DateTime               @map("fecha_emision") @db.Date
  moneda                 Moneda                 @default(PEN)
  tipoCambio             Decimal                @default(1) @map("tipo_cambio") @db.Decimal(10, 4)
  observacion            String?
  subtotal               Decimal                @default(0) @db.Decimal(14, 2)
  igv                    Decimal                @default(0) @db.Decimal(14, 2)
  total                  Decimal                @default(0) @db.Decimal(14, 2)
  creadoPorId            String                 @map("creado_por_id") @db.Uuid
  confirmadoPorId        String?                @map("confirmado_por_id") @db.Uuid
  confirmadoEn           DateTime?              @map("confirmado_en")
  anuladoPorId           String?                @map("anulado_por_id") @db.Uuid
  anuladoEn              DateTime?              @map("anulado_en")
  motivoAnulacion        String?                @map("motivo_anulacion")
  movimientoId           String?                @unique @map("movimiento_id") @db.Uuid
  /// Validación del comprobante del proveedor en SUNAT (consulta integrada de validez)
  validacionEstado       String?                @map("validacion_estado")
  validacionMensaje      String?                @map("validacion_mensaje")
  validacionRucEstado    String?                @map("validacion_ruc_estado")
  validacionRucCondicion String?                @map("validacion_ruc_condicion")
  validadoEn             DateTime?              @map("validado_en")
  /// Compras sujetas al SPOT: el IGV da crédito fiscal recién cuando se deposita la detracción
  detraccionMonto        Decimal                @default(0) @map("detraccion_monto") @db.Decimal(14, 2)
  detraccionConstancia   String?                @map("detraccion_constancia")
  detraccionFecha        DateTime?              @map("detraccion_fecha") @db.Date
  movimientoAnulacionId  String?                @map("movimiento_anulacion_id") @db.Uuid
  creadoEn               DateTime               @default(now()) @map("creado_en")
  actualizadoEn          DateTime               @updatedAt @map("actualizado_en")

  empresa    Empresa                     @relation(fields: [empresaId], references: [id])
  almacen    Almacen                     @relation(fields: [almacenId], references: [id])
  movimiento Movimiento?                 @relation("MovimientoDocumento", fields: [movimientoId], references: [id])
  detalles   DocumentoComercialDetalle[]

  /// Evita registrar dos veces el mismo comprobante (del mismo proveedor en compras)
  @@unique([empresaId, tipo, terceroDocumento, comprobanteTipo, serie, numero])
  @@index([tenantId])
  @@index([empresaId, tipo, fechaEmision])
  @@map("documentos_comerciales")
}

model DocumentoComercialDetalle {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  documentoId   String  @map("documento_id") @db.Uuid
  productoId    String  @map("producto_id") @db.Uuid
  cantidad      Decimal @db.Decimal(18, 4)
  /// Valor unitario SIN IGV en la moneda del documento
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(18, 6)
  afectoIgv     Boolean @default(true) @map("afecto_igv")
  subtotal      Decimal @db.Decimal(14, 2)

  documento DocumentoComercial @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  producto  Producto           @relation(fields: [productoId], references: [id])

  @@unique([documentoId, productoId])
  @@index([tenantId])
  @@map("documento_comercial_detalles")
}

/// Códigos de recuperación de 2FA (de un solo uso, guardados como hash)
model MfaCodigoRecuperacion {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  codigoHash String    @map("codigo_hash")
  usadoEn    DateTime? @map("usado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tenantId])
  @@map("mfa_codigos_recuperacion")
}

// ═══════════════════════ Módulo C: plataforma SaaS (multi-estudio) ═══════════════════════
// Tablas GLOBALES (sin tenant_id). El rol de aplicación kardex_app NO tiene acceso a ellas:
// solo las usa la API de plataforma con la conexión dueña.

enum RolPlataforma {
  ADMIN
  SOPORTE
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}

/// Usuarios de la plataforma: autenticación separada de la de los estudios, 2FA obligatorio
model PlataformaAdmin {
  id               String        @id @default(uuid()) @db.Uuid
  nombres          String
  email            String        @unique
  passwordHash     String        @map("password_hash")
  rol              RolPlataforma @default(SOPORTE)
  activo           Boolean       @default(true)
  mfaActivo        Boolean       @default(false) @map("mfa_activo")
  mfaSecret        String?       @map("mfa_secret")
  intentosFallidos Int           @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime?     @map("bloqueado_hasta")
  ultimoAcceso     DateTime?     @map("ultimo_acceso")
  creadoEn         DateTime      @default(now()) @map("creado_en")

  sesiones PlataformaSesion[]
  codigos  PlataformaCodigoRecuperacion[]

  @@map("plataforma_admins")
}

model PlataformaSesion {
  id               String   @id @default(uuid()) @db.Uuid
  adminId          String   @map("admin_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  ip               String?
  dispositivo      String?
  expiraEn         DateTime @map("expira_en")
  revocada         Boolean  @default(false)
  creadaEn         DateTime @default(now()) @map("creada_en")

  admin PlataformaAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("plataforma_sesiones")
}

model PlataformaCodigoRecuperacion {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  codigoHash String    @map("codigo_hash")
  usadoEn    DateTime? @map("usado_en")

  admin PlataformaAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("plataforma_codigos_recuperacion")
}

/// Planes comerciales. null en un límite = ilimitado
model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  codigo        String   @unique
  nombre        String
  descripcion   String?
  precioMensual Decimal  @map("precio_mensual") @db.Decimal(10, 2)
  maxEmpresas   Int?     @map("max_empresas")
  maxUsuarios   Int?     @map("max_usuarios")
  maxAlmacenes  Int?     @map("max_almacenes")
  /// Módulos que incluye el plan (inventario, pos, cxc, facturacion…)
  modulos       String[] @default(["inventario", "pos", "cxc", "facturacion", "sire", "contabilidad"])
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")

  estudios Tenant[]
  facturas FacturaPlataforma[]

  @@map("planes")
}

/// Cobro mensual a un estudio (una por estudio y periodo)
model FacturaPlataforma {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  planId          String        @map("plan_id") @db.Uuid
  /// Periodo facturado, formato AAAA-MM
  periodo         String
  monto           Decimal       @db.Decimal(10, 2)
  estado          EstadoFactura @default(PENDIENTE)
  emitidaEn       DateTime      @default(now()) @map("emitida_en")
  venceEn         DateTime      @map("vence_en") @db.Date
  pagadaEn        DateTime?     @map("pagada_en")
  referenciaPago  String?       @map("referencia_pago")
  motivoAnulacion String?       @map("motivo_anulacion")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@unique([tenantId, periodo])
  @@index([estado])
  @@map("facturas_plataforma")
}

/// Auditoría inmutable de las acciones de la plataforma
model PlataformaAuditoria {
  id        BigInt   @id @default(autoincrement())
  adminId   String?  @map("admin_id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  accion    String
  recurso   String
  recursoId String?  @map("recurso_id")
  antes     Json?
  despues   Json?
  ip        String?
  fecha     DateTime @default(now())

  @@index([fecha])
  @@index([tenantId])
  @@map("plataforma_auditoria")
}

// ───────────────────────── Exportaciones de reportes en segundo plano ─────────────────────────

/// Solicitud de exportación procesada por la cola (BullMQ). El archivo vive en disco 24 h
/// y solo lo descarga el usuario que lo pidió.
model ExportacionReporte {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  usuarioId     String            @map("usuario_id") @db.Uuid
  empresaId     String            @map("empresa_id") @db.Uuid
  tipo          String
  formato       String
  parametros    Json
  titulo        String?
  estado        EstadoExportacion @default(PENDIENTE)
  /// 0–100
  progreso      Int               @default(0)
  filas         Int?
  nombreArchivo String?           @map("nombre_archivo")
  rutaArchivo   String?           @map("ruta_archivo")
  tamanoBytes   Int?              @map("tamano_bytes")
  error         String?
  creadoEn      DateTime          @default(now()) @map("creado_en")
  iniciadoEn    DateTime?         @map("iniciado_en")
  terminadoEn   DateTime?         @map("terminado_en")
  expiraEn      DateTime?         @map("expira_en")

  @@index([tenantId])
  @@index([usuarioId, creadoEn])
  @@index([estado, expiraEn])
  @@map("exportaciones_reporte")
}

// ═══════════════════════ Punto de venta y comprobantes ═══════════════════════

/// Cliente de una empresa (a quien se le vende). "Clientes varios" no se guarda como registro.
model Cliente {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  empresaId         String           @map("empresa_id") @db.Uuid
  tipoDocumento     TipoDocIdentidad @map("tipo_documento")
  numeroDocumento   String           @map("numero_documento")
  nombre            String
  direccion         String?
  email             String?
  telefono          String?
  /// Persona natural con negocio: su RUC 10 para emitirle factura sin registrarla dos veces
  rucAsociado       String?          @map("ruc_asociado")
  /// El cliente es agente de retención del IGV (retiene 3% en facturas mayores a S/ 700)
  agenteRetencion   Boolean          @default(false) @map("agente_retencion")
  /// Venta al crédito: habilitado, tope de deuda (null = sin tope) y plazo por defecto
  creditoHabilitado Boolean          @default(false) @map("credito_habilitado")
  limiteCredito     Decimal?         @map("limite_credito") @db.Decimal(14, 2)
  diasCredito       Int              @default(30) @map("dias_credito")
  activo            Boolean          @default(true)
  creadoEn          DateTime         @default(now()) @map("creado_en")
  actualizadoEn     DateTime         @updatedAt @map("actualizado_en")

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  comprobantes Comprobante[]
  cobranzas    Cobranza[]

  @@unique([empresaId, tipoDocumento, numeroDocumento])
  @@index([tenantId])
  @@index([empresaId, nombre])
  @@map("clientes")
}

/// Caja (punto de venta) de un almacén, con sus series de comprobantes
model Caja {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  empresaId               String   @map("empresa_id") @db.Uuid
  sedeId                  String   @map("sede_id") @db.Uuid
  almacenId               String   @map("almacen_id") @db.Uuid
  nombre                  String
  serieFactura            String   @map("serie_factura")
  serieBoleta             String   @map("serie_boleta")
  serieNotaVenta          String   @map("serie_nota_venta")
  serieNotaCreditoFactura String   @map("serie_nota_credito_factura")
  serieNotaCreditoBoleta  String   @map("serie_nota_credito_boleta")
  /// Rebaja máxima (%) que el cajero aplica sin autorización de un supervisor
  descuentoMaximo         Decimal  @default(5) @map("descuento_maximo") @db.Decimal(5, 2)
  activo                  Boolean  @default(true)
  creadoEn                DateTime @default(now()) @map("creado_en")
  actualizadoEn           DateTime @updatedAt @map("actualizado_en")

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  almacen      Almacen       @relation(fields: [almacenId], references: [id])
  sesiones     SesionCaja[]
  comprobantes Comprobante[]

  @@unique([empresaId, nombre])
  @@index([tenantId])
  @@map("cajas")
}

/// Turno de caja: apertura → ventas → cierre con arqueo
model SesionCaja {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  cajaId            String           @map("caja_id") @db.Uuid
  usuarioId         String           @map("usuario_id") @db.Uuid
  estado            EstadoSesionCaja @default(ABIERTA)
  montoApertura     Decimal          @map("monto_apertura") @db.Decimal(14, 2)
  abiertaEn         DateTime         @default(now()) @map("abierta_en")
  cerradaEn         DateTime?        @map("cerrada_en")
  efectivoEsperado  Decimal?         @map("efectivo_esperado") @db.Decimal(14, 2)
  efectivoDeclarado Decimal?         @map("efectivo_declarado") @db.Decimal(14, 2)
  diferencia        Decimal?         @db.Decimal(14, 2)
  /// Totales por medio de pago y por tipo de comprobante al cierre
  resumen           Json?
  observacion       String?

  caja         Caja          @relation(fields: [cajaId], references: [id])
  comprobantes Comprobante[]
  cobranzas    Cobranza[]

  @@index([tenantId])
  @@index([cajaId, estado])
  @@map("sesiones_caja")
}

/// Comprobante emitido en caja (factura, boleta, nota de venta o nota de crédito).
/// Inmutable en sus importes: se anula (en el mismo turno) o se corrige con nota de crédito.
model Comprobante {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  empresaId              String            @map("empresa_id") @db.Uuid
  sedeId                 String            @map("sede_id") @db.Uuid
  almacenId              String            @map("almacen_id") @db.Uuid
  cajaId                 String            @map("caja_id") @db.Uuid
  sesionCajaId           String            @map("sesion_caja_id") @db.Uuid
  tipo                   TipoComprobante
  serie                  String
  numero                 Int
  fechaEmision           DateTime          @default(now()) @map("fecha_emision")
  moneda                 String            @default("PEN")
  clienteId              String?           @map("cliente_id") @db.Uuid
  clienteTipoDocumento   TipoDocIdentidad  @map("cliente_tipo_documento")
  clienteNumeroDocumento String            @map("cliente_numero_documento")
  clienteNombre          String            @map("cliente_nombre")
  clienteDireccion       String?           @map("cliente_direccion")
  opGravada              Decimal           @default(0) @map("op_gravada") @db.Decimal(14, 2)
  opExonerada            Decimal           @default(0) @map("op_exonerada") @db.Decimal(14, 2)
  opInafecta             Decimal           @default(0) @map("op_inafecta") @db.Decimal(14, 2)
  igv                    Decimal           @default(0) @db.Decimal(14, 2)
  descuentoTotal         Decimal           @default(0) @map("descuento_total") @db.Decimal(14, 2)
  /// Parte de descuentoTotal que vino de un descuento sobre toda la venta (prorrateado en las líneas)
  descuentoGlobal        Decimal           @default(0) @map("descuento_global") @db.Decimal(14, 2)
  /// SPOT: detracción que el cliente deposita en la cuenta del Banco de la Nación
  detraccionCodigo       String?           @map("detraccion_codigo")
  detraccionPorcentaje   Decimal?          @map("detraccion_porcentaje") @db.Decimal(5, 2)
  detraccionMonto        Decimal           @default(0) @map("detraccion_monto") @db.Decimal(14, 2)
  /// Retención del IGV (3%) que aplica el cliente agente de retención
  retencionMonto         Decimal           @default(0) @map("retencion_monto") @db.Decimal(14, 2)
  total                  Decimal           @db.Decimal(14, 2)
  formaPago              FormaPago         @default(CONTADO) @map("forma_pago")
  /// Crédito: monto financiado (total − pago inicial) y lo que aún se debe
  montoCredito           Decimal           @default(0) @map("monto_credito") @db.Decimal(14, 2)
  saldoPendiente         Decimal           @default(0) @map("saldo_pendiente") @db.Decimal(14, 2)
  /// Nota de crédito sobre una venta al crédito: parte que redujo la deuda (no se reembolsó)
  aplicadoASaldo         Decimal           @default(0) @map("aplicado_a_saldo") @db.Decimal(14, 2)
  /// Supervisor que autorizó un descuento sobre el tope o un crédito fuera de límite
  autorizadoPorId        String?           @map("autorizado_por_id") @db.Uuid
  autorizacion           String?
  montoRecibido          Decimal?          @map("monto_recibido") @db.Decimal(14, 2)
  vuelto                 Decimal           @default(0) @db.Decimal(14, 2)
  estado                 EstadoComprobante @default(EMITIDO)
  estadoSunat            EstadoSunat       @map("estado_sunat")
  /// Respuesta de SUNAT (vía el proveedor) y representación oficial
  sunatCodigo            String?           @map("sunat_codigo")
  sunatDescripcion       String?           @map("sunat_descripcion")
  sunatHash              String?           @map("sunat_hash")
  sunatQr                String?           @map("sunat_qr")
  sunatPdf               String?           @map("sunat_pdf")
  sunatXml               String?           @map("sunat_xml")
  sunatCdr               String?           @map("sunat_cdr")
  sunatIntentos          Int               @default(0) @map("sunat_intentos")
  sunatUltimoError       String?           @map("sunat_ultimo_error")
  sunatEnviadoEn         DateTime?         @map("sunat_enviado_en")
  /// Comunicación de baja (anulación ante SUNAT de un comprobante ya aceptado)
  bajaEstado             String?           @map("baja_estado")
  bajaTicket             String?           @map("baja_ticket")
  bajaMensaje            String?           @map("baja_mensaje")
  /// Nota de crédito: comprobante que modifica y motivo (catálogo 09)
  referenciaId           String?           @map("referencia_id") @db.Uuid
  motivoCodigo           String?           @map("motivo_codigo")
  motivoDescripcion      String?           @map("motivo_descripcion")
  movimientoId           String?           @unique @map("movimiento_id") @db.Uuid
  movimientoAnulacionId  String?           @map("movimiento_anulacion_id") @db.Uuid
  usuarioId              String            @map("usuario_id") @db.Uuid
  anuladoPorId           String?           @map("anulado_por_id") @db.Uuid
  anuladoEn              DateTime?         @map("anulado_en")
  motivoAnulacion        String?           @map("motivo_anulacion")
  observacion            String?
  creadoEn               DateTime          @default(now()) @map("creado_en")

  empresa      Empresa              @relation(fields: [empresaId], references: [id])
  caja         Caja                 @relation(fields: [cajaId], references: [id])
  sesion       SesionCaja           @relation(fields: [sesionCajaId], references: [id])
  cliente      Cliente?             @relation(fields: [clienteId], references: [id])
  referencia   Comprobante?         @relation("NotaCredito", fields: [referenciaId], references: [id])
  notasCredito Comprobante[]        @relation("NotaCredito")
  movimiento   Movimiento?          @relation("MovimientoComprobante", fields: [movimientoId], references: [id])
  detalles     ComprobanteDetalle[]
  pagos        ComprobantePago[]
  cuotas       ComprobanteCuota[]
  cobranzas    Cobranza[]

  @@unique([empresaId, serie, numero])
  @@index([clienteId, saldoPendiente])
  @@index([tenantId])
  @@index([empresaId, fechaEmision])
  @@index([sesionCajaId])
  @@map("comprobantes")
}

model ComprobanteDetalle {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  comprobanteId  String  @map("comprobante_id") @db.Uuid
  productoId     String  @map("producto_id") @db.Uuid
  /// Copia de la descripción y unidad al momento de emitir (el comprobante no cambia si el producto cambia)
  descripcion    String
  unidadCodigo   String  @map("unidad_codigo")
  cantidad       Decimal @db.Decimal(18, 4)
  /// Precio unitario CON IGV
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(14, 4)
  /// Valor unitario SIN IGV
  valorUnitario  Decimal @map("valor_unitario") @db.Decimal(18, 6)
  descuento      Decimal @default(0) @db.Decimal(14, 2)
  afectacionIgv  String  @map("afectacion_igv")
  /// Valor de venta (sin IGV), IGV y total (con IGV) de la línea
  valorVenta     Decimal @map("valor_venta") @db.Decimal(14, 2)
  igv            Decimal @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  producto    Producto    @relation(fields: [productoId], references: [id])

  @@index([tenantId])
  @@index([comprobanteId])
  @@map("comprobante_detalles")
}

/// Pagos (ventas, positivos) o reembolsos (notas de crédito, negativos)
model ComprobantePago {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  comprobanteId String    @map("comprobante_id") @db.Uuid
  medio         MedioPago
  monto         Decimal   @db.Decimal(14, 2)
  referencia    String?

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([comprobanteId])
  @@map("comprobante_pagos")
}

/// Cuotas de una venta al crédito (obligatorias en la factura al crédito según SUNAT)
model ComprobanteCuota {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  comprobanteId    String   @map("comprobante_id") @db.Uuid
  numero           Int
  monto            Decimal  @db.Decimal(14, 2)
  fechaVencimiento DateTime @map("fecha_vencimiento") @db.Date

  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@unique([comprobanteId, numero])
  @@index([tenantId])
  @@map("comprobante_cuotas")
}

/// Pago de un cliente a cuenta de una venta al crédito
model Cobranza {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  empresaId       String         @map("empresa_id") @db.Uuid
  clienteId       String         @map("cliente_id") @db.Uuid
  comprobanteId   String         @map("comprobante_id") @db.Uuid
  /// Si se cobró en caja, entra al arqueo de ese turno
  sesionCajaId    String?        @map("sesion_caja_id") @db.Uuid
  numero          Int
  fecha           DateTime       @default(now())
  medio           MedioPago
  monto           Decimal        @db.Decimal(14, 2)
  referencia      String?
  observacion     String?
  estado          EstadoCobranza @default(VIGENTE)
  usuarioId       String         @map("usuario_id") @db.Uuid
  anuladoPorId    String?        @map("anulado_por_id") @db.Uuid
  anuladoEn       DateTime?      @map("anulado_en")
  motivoAnulacion String?        @map("motivo_anulacion")

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  comprobante Comprobante @relation(fields: [comprobanteId], references: [id])
  sesion      SesionCaja? @relation(fields: [sesionCajaId], references: [id])

  @@unique([empresaId, numero])
  @@index([tenantId])
  @@index([clienteId])
  @@index([comprobanteId])
  @@index([sesionCajaId])
  @@map("cobranzas")
}

/// Conexión de la empresa con su proveedor de facturación electrónica (OSE/PSE)
model ConfigFacturacion {
  id                       String       @id @default(uuid()) @db.Uuid
  tenantId                 String       @map("tenant_id") @db.Uuid
  empresaId                String       @unique @map("empresa_id") @db.Uuid
  proveedor                ProveedorCpe @default(SIMULADO)
  ambiente                 AmbienteCpe  @default(PRUEBAS)
  /// Ruta del API que entrega el proveedor (Nubefact: una por cuenta)
  url                      String?
  /// Token del proveedor, cifrado (AES-256-GCM); nunca se devuelve al navegador
  tokenCifrado             String?      @map("token_cifrado")
  envioAutomatico          Boolean      @default(true) @map("envio_automatico")
  /// Serie de las guías de remisión electrónicas (remitente)
  serieGuia                String       @default("T001") @map("serie_guia")
  /// Credenciales API de SUNAT (Consulta de validez de comprobantes), generadas en SOL
  sunatClientId            String?      @map("sunat_client_id")
  sunatClientSecretCifrado String?      @map("sunat_client_secret_cifrado")
  activo                   Boolean      @default(true)
  creadoEn                 DateTime     @default(now()) @map("creado_en")
  actualizadoEn            DateTime     @updatedAt @map("actualizado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([tenantId])
  @@map("config_facturacion")
}

/// Guía de remisión electrónica remitente (tipo 09): sustenta el traslado de bienes
model GuiaRemision {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  empresaId              String            @map("empresa_id") @db.Uuid
  sedeId                 String            @map("sede_id") @db.Uuid
  /// Almacén de partida (define el alcance: quién la ve y la emite)
  almacenId              String            @map("almacen_id") @db.Uuid
  serie                  String
  numero                 Int
  fechaEmision           DateTime          @default(now()) @map("fecha_emision")
  fechaTraslado          DateTime          @map("fecha_traslado") @db.Date
  /// Catálogo 20 de SUNAT (01 venta, 02 compra, 04 entre establecimientos, 13 otros…)
  motivo                 String
  motivoDescripcion      String?           @map("motivo_descripcion")
  modalidad              ModalidadTraslado
  destinatarioTipoDoc    TipoDocIdentidad  @map("destinatario_tipo_doc")
  destinatarioNumDoc     String            @map("destinatario_num_doc")
  destinatarioNombre     String            @map("destinatario_nombre")
  partidaUbigeo          String            @map("partida_ubigeo")
  partidaDireccion       String            @map("partida_direccion")
  partidaEstablecimiento String?           @map("partida_establecimiento")
  llegadaUbigeo          String            @map("llegada_ubigeo")
  llegadaDireccion       String            @map("llegada_direccion")
  llegadaEstablecimiento String?           @map("llegada_establecimiento")
  pesoBruto              Decimal           @map("peso_bruto") @db.Decimal(12, 3)
  unidadPeso             String            @default("KGM") @map("unidad_peso")
  bultos                 Int?
  transportistaRuc       String?           @map("transportista_ruc")
  transportistaNombre    String?           @map("transportista_nombre")
  transportistaMtc       String?           @map("transportista_mtc")
  conductorTipoDoc       TipoDocIdentidad? @map("conductor_tipo_doc")
  conductorNumDoc        String?           @map("conductor_num_doc")
  conductorNombres       String?           @map("conductor_nombres")
  conductorApellidos     String?           @map("conductor_apellidos")
  conductorLicencia      String?           @map("conductor_licencia")
  vehiculoPlaca          String?           @map("vehiculo_placa")
  /// Comprobante relacionado (venta): catálogo 01 + serie-número
  docRelTipo             String?           @map("doc_rel_tipo")
  docRelSerie            String?           @map("doc_rel_serie")
  docRelNumero           String?           @map("doc_rel_numero")
  transferenciaId        String?           @map("transferencia_id") @db.Uuid
  comprobanteId          String?           @map("comprobante_id") @db.Uuid
  observacion            String?
  /// EMITIDA | ANULADA (solo se anula si aún no se envió a SUNAT)
  estado                 String            @default("EMITIDA")
  estadoSunat            EstadoSunat       @default(PENDIENTE) @map("estado_sunat")
  sunatCodigo            String?           @map("sunat_codigo")
  sunatDescripcion       String?           @map("sunat_descripcion")
  sunatHash              String?           @map("sunat_hash")
  sunatQr                String?           @map("sunat_qr")
  sunatPdf               String?           @map("sunat_pdf")
  sunatXml               String?           @map("sunat_xml")
  sunatCdr               String?           @map("sunat_cdr")
  sunatIntentos          Int               @default(0) @map("sunat_intentos")
  sunatUltimoError       String?           @map("sunat_ultimo_error")
  sunatEnviadoEn         DateTime?         @map("sunat_enviado_en")
  usuarioId              String            @map("usuario_id") @db.Uuid
  creadoEn               DateTime          @default(now()) @map("creado_en")

  empresa  Empresa               @relation(fields: [empresaId], references: [id])
  detalles GuiaRemisionDetalle[]

  @@unique([empresaId, serie, numero])
  @@index([tenantId])
  @@index([empresaId, fechaEmision])
  @@index([transferenciaId])
  @@index([comprobanteId])
  @@map("guias_remision")
}

model GuiaRemisionDetalle {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  guiaId       String  @map("guia_id") @db.Uuid
  productoId   String? @map("producto_id") @db.Uuid
  codigo       String?
  descripcion  String
  unidadCodigo String  @map("unidad_codigo")
  cantidad     Decimal @db.Decimal(18, 4)

  guia GuiaRemision @relation(fields: [guiaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([guiaId])
  @@map("guia_remision_detalles")
}

/// Credenciales del SIRE de UNA empresa. Los secretos van cifrados y nunca salen del servidor.
model ConfigSire {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  empresaId           String    @unique @map("empresa_id") @db.Uuid
  modo                ModoSire  @default(SIMULADO)
  /// Credenciales API SUNAT (SOL → Credenciales de API SUNAT, con acceso al SIRE)
  clientId            String?   @map("client_id")
  clientSecretCifrado String?   @map("client_secret_cifrado")
  /// Usuario secundario SOL con perfil SIRE (sin el RUC) y su clave
  usuarioSol          String?   @map("usuario_sol")
  claveSolCifrada     String?   @map("clave_sol_cifrada")
  activo              Boolean   @default(true)
  ultimaConexion      DateTime? @map("ultima_conexion")
  ultimoError         String?   @map("ultimo_error")
  creadoEn            DateTime  @default(now()) @map("creado_en")
  actualizadoEn       DateTime  @updatedAt @map("actualizado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([tenantId])
  @@map("config_sire")
}

/// Período tributario (AAAAMM) de una empresa y el avance de sus registros SIRE.
/// Solo existe cuando hubo actividad; sin fila, ambos registros están PENDIENTES.
model PeriodoSire {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  empresaId      String             @map("empresa_id") @db.Uuid
  periodo        String             @db.Char(6)
  estadoRvie     EstadoRegistroSire @default(PENDIENTE) @map("estado_rvie")
  estadoRce      EstadoRegistroSire @default(PENDIENTE) @map("estado_rce")
  /// Estado tal como lo informa SUNAT en la última sincronización
  sunatRvie      String?            @map("sunat_rvie")
  sunatRce       String?            @map("sunat_rce")
  sincronizadoEn DateTime?          @map("sincronizado_en")
  creadoEn       DateTime           @default(now()) @map("creado_en")
  actualizadoEn  DateTime           @updatedAt @map("actualizado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, periodo])
  @@index([tenantId])
  @@map("periodos_sire")
}

/// Cronograma oficial de vencimientos mensuales de SUNAT (global, lo carga la plataforma).
/// grupo: último dígito del RUC ("0"…"9") o "BC" (buenos contribuyentes y UESP).
model CronogramaSunat {
  id            String   @id @default(uuid()) @db.Uuid
  periodo       String   @db.Char(6)
  grupo         String   @db.VarChar(2)
  vencimiento   DateTime @db.Date
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@unique([periodo, grupo])
  @@map("cronograma_sunat")
}

/// Operación con el SIRE que SUNAT atiende por ticket: descargar una propuesta o aceptarla.
model OperacionSire {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  empresaId   String              @map("empresa_id") @db.Uuid
  periodo     String              @db.Char(6)
  registro    RegistroSire
  tipo        TipoOperacionSire
  estado      EstadoOperacionSire @default(PROCESANDO)
  ticket      String?
  codProceso  String?             @map("cod_proceso")
  intentos    Int                 @default(0)
  mensaje     String?
  /// Constancia o número de operación que devuelve SUNAT al aceptar
  constancia  String?
  usuarioId   String              @map("usuario_id") @db.Uuid
  creadoEn    DateTime            @default(now()) @map("creado_en")
  terminadoEn DateTime?           @map("terminado_en")

  empresa   Empresa        @relation(fields: [empresaId], references: [id])
  propuesta PropuestaSire?

  @@index([tenantId])
  @@index([empresaId, periodo, registro])
  @@map("operaciones_sire")
}

/// Propuesta descargada de SUNAT. Solo la última de cada período y registro es la vigente.
model PropuestaSire {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  empresaId    String       @map("empresa_id") @db.Uuid
  periodo      String       @db.Char(6)
  registro     RegistroSire
  operacionId  String?      @unique @map("operacion_id") @db.Uuid
  vigente      Boolean      @default(true)
  cantidad     Int          @default(0)
  totalBase    Decimal      @default(0) @map("total_base") @db.Decimal(16, 2)
  totalIgv     Decimal      @default(0) @map("total_igv") @db.Decimal(16, 2)
  total        Decimal      @default(0) @db.Decimal(16, 2)
  descargadaEn DateTime     @default(now()) @map("descargada_en")

  empresa     Empresa                @relation(fields: [empresaId], references: [id])
  operacion   OperacionSire?         @relation(fields: [operacionId], references: [id])
  detalles    PropuestaSireDetalle[]
  diferencias DiferenciaSire[]

  @@index([tenantId])
  @@index([empresaId, periodo, registro, vigente])
  @@map("propuestas_sire")
}

/// Comprobante de la propuesta de SUNAT (montos en la moneda del comprobante; NC en positivo)
model PropuestaSireDetalle {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  propuestaId  String   @map("propuesta_id") @db.Uuid
  /// Tipo de comprobante (catálogo 10 de SUNAT: 01 factura, 03 boleta, 07 NC, 08 ND)
  tipoCp       String   @map("tipo_cp") @db.VarChar(2)
  serie        String
  numero       String
  fechaEmision DateTime @map("fecha_emision") @db.Date
  /// Tipo de documento de identidad (catálogo 06) y número
  docTipo      String?  @map("doc_tipo") @db.VarChar(2)
  docNumero    String?  @map("doc_numero")
  nombre       String?
  baseGravada  Decimal  @default(0) @map("base_gravada") @db.Decimal(14, 2)
  igv          Decimal  @default(0) @db.Decimal(14, 2)
  exonerado    Decimal  @default(0) @db.Decimal(14, 2)
  inafecto     Decimal  @default(0) @db.Decimal(14, 2)
  otros        Decimal  @default(0) @db.Decimal(14, 2)
  total        Decimal  @default(0) @db.Decimal(14, 2)
  moneda       String   @default("PEN") @db.VarChar(3)
  anulado      Boolean  @default(false)
  refTipo      String?  @map("ref_tipo") @db.VarChar(2)
  refSerie     String?  @map("ref_serie")
  refNumero    String?  @map("ref_numero")

  propuesta PropuestaSire @relation(fields: [propuestaId], references: [id])

  @@index([tenantId])
  @@index([propuestaId])
  @@map("propuestas_sire_detalle")
}

/// Diferencia encontrada al conciliar una propuesta con el sistema, y cómo se resolvió.
model DiferenciaSire {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  propuestaId        String               @map("propuesta_id") @db.Uuid
  tipo               TipoDiferenciaSire
  /// tipo-serie-número, para reconocerla al volver a descargar la propuesta
  clave              String
  tipoCp             String               @map("tipo_cp") @db.VarChar(2)
  serie              String
  numero             String
  fechaEmision       DateTime?            @map("fecha_emision") @db.Date
  /// RCE: RUC del proveedor (forma parte de la clave)
  docNumero          String?              @map("doc_numero")
  nombre             String?
  totalSunat         Decimal?             @map("total_sunat") @db.Decimal(14, 2)
  totalSistema       Decimal?             @map("total_sistema") @db.Decimal(14, 2)
  igvSunat           Decimal?             @map("igv_sunat") @db.Decimal(14, 2)
  igvSistema         Decimal?             @map("igv_sistema") @db.Decimal(14, 2)
  /// Origen en el sistema: comprobante de caja o documento de venta
  comprobanteId      String?              @map("comprobante_id") @db.Uuid
  documentoId        String?              @map("documento_id") @db.Uuid
  estadoSunatSistema String?              @map("estado_sunat_sistema")
  resolucion         ResolucionDiferencia @default(PENDIENTE)
  nota               String?
  resueltoPorId      String?              @map("resuelto_por_id") @db.Uuid
  resueltoEn         DateTime?            @map("resuelto_en")

  propuesta PropuestaSire @relation(fields: [propuestaId], references: [id])

  @@index([tenantId])
  @@index([propuestaId, resolucion])
  @@map("diferencias_sire")
}

/// Cuenta del plan contable de una empresa (PCGE). El código anida por prefijo (12 → 121 → 1212):
/// la jerarquía y si es imputable se calculan a partir de los códigos.
model CuentaContable {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  empresaId     String           @map("empresa_id") @db.Uuid
  codigo        String           @db.VarChar(10)
  nombre        String
  naturaleza    NaturalezaCuenta
  /// Se analiza por cliente o proveedor (cuentas por cobrar y por pagar)
  pideTercero   Boolean          @default(false) @map("pide_tercero")
  /// Cuentas de gasto (elemento 6): amarre al elemento 9 (debe) y a la 79 (haber)
  destinoDebe   String?          @map("destino_debe") @db.VarChar(10)
  destinoHaber  String?          @map("destino_haber") @db.VarChar(10)
  activo        Boolean          @default(true)
  creadoEn      DateTime         @default(now()) @map("creado_en")
  actualizadoEn DateTime         @updatedAt @map("actualizado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, codigo])
  @@index([tenantId])
  @@map("cuentas_contables")
}

/// Configuración contable de una empresa: qué cuenta usa cada operación en los asientos automáticos
model ConfigContable {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  empresaId     String   @unique @map("empresa_id") @db.Uuid
  /// { clave de operación: código de cuenta } (ver CUENTAS_OPERACION)
  cuentas       Json     @default("{}")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([tenantId])
  @@map("config_contable")
}

/// Asiento contable. Los automáticos se generan una sola vez por operación (clave única);
/// si la operación se anula, se registra un extorno en lugar de borrar el asiento.
model Asiento {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  empresaId     String        @map("empresa_id") @db.Uuid
  periodo       String        @db.Char(6)
  /// Correlativo dentro del período
  numero        Int
  fecha         DateTime      @db.Date
  glosa         String
  origen        OrigenAsiento
  /// Identifica la operación de origen: VENTA:<id>, COSTO:<id>… (con ":EXTORNO" para la reversión)
  clave         String
  comprobanteId String?       @map("comprobante_id") @db.Uuid
  documentoId   String?       @map("documento_id") @db.Uuid
  cobranzaId    String?       @map("cobranza_id") @db.Uuid
  movimientoId  String?       @map("movimiento_id") @db.Uuid
  extornoDeId   String?       @map("extorno_de_id") @db.Uuid
  totalDebe     Decimal       @map("total_debe") @db.Decimal(16, 2)
  totalHaber    Decimal       @map("total_haber") @db.Decimal(16, 2)
  usuarioId     String?       @map("usuario_id") @db.Uuid
  creadoEn      DateTime      @default(now()) @map("creado_en")

  empresa   Empresa        @relation(fields: [empresaId], references: [id])
  extornoDe Asiento?       @relation("Extorno", fields: [extornoDeId], references: [id])
  extornos  Asiento[]      @relation("Extorno")
  lineas    AsientoLinea[]

  @@unique([empresaId, clave])
  @@unique([empresaId, periodo, numero])
  @@index([tenantId])
  @@index([empresaId, periodo, fecha])
  @@map("asientos")
}

/// Línea de un asiento: una cuenta al debe o al haber, con el tercero y el documento para el análisis
model AsientoLinea {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  asientoId     String  @map("asiento_id") @db.Uuid
  orden         Int
  cuenta        String  @db.VarChar(10)
  debe          Decimal @default(0) @db.Decimal(16, 2)
  haber         Decimal @default(0) @db.Decimal(16, 2)
  glosa         String?
  /// Tercero (catálogo 06) y documento (catálogo 10) de las cuentas por cobrar y por pagar
  terceroTipo   String? @map("tercero_tipo") @db.VarChar(2)
  terceroDoc    String? @map("tercero_doc")
  terceroNombre String? @map("tercero_nombre")
  docTipo       String? @map("doc_tipo") @db.VarChar(2)
  docSerie      String? @map("doc_serie")
  docNumero     String? @map("doc_numero")

  asiento Asiento @relation(fields: [asientoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([asientoId])
  @@map("asiento_lineas")
}

/// Estado contable de un período de la empresa. Sin fila, el período está abierto.
/// Cerrado: no se crean, editan ni borran asientos (lo impide también un trigger).
model PeriodoContable {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  empresaId        String    @map("empresa_id") @db.Uuid
  periodo          String    @db.Char(6)
  cerrado          Boolean   @default(false)
  cerradoEn        DateTime? @map("cerrado_en")
  cerradoPorId     String?   @map("cerrado_por_id") @db.Uuid
  reabiertoEn      DateTime? @map("reabierto_en")
  motivoReapertura String?   @map("motivo_reapertura")
  actualizadoEn    DateTime  @updatedAt @map("actualizado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, periodo])
  @@index([tenantId])
  @@map("periodos_contables")
}
