NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# Conexión DUEÑA (migraciones, seed y flujos de autenticación previos al tenant)
DATABASE_URL=postgresql://kardex_owner:kardex_owner@localhost:5432/kardex
# Conexión de APLICACIÓN (rol sin privilegios, sujeto a RLS)
DATABASE_APP_URL=postgresql://kardex_app:kardex_app@localhost:5432/kardex

REDIS_URL=redis://localhost:6379

# Genere con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=0a60d9e9823ce65d18ea1bbcb1a6693260749e7da1792a0ef7648ae251ff1593fef10134502c59f64b9f93dcf983185c
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DIAS=7

PASSWORD_MIN_LENGTH=8
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# SMTP (si se omite, los enlaces de invitación se imprimen en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kardex <no-reply@kardex.local>"

# Seed de desarrollo
SEED_ADMIN_EMAIL=admin@kardex.local
SEED_ADMIN_PASSWORD=Admin123!

# Cifrado de secretos 2FA. Genere con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=d74c396893043f2cc2c98e3b751dc19f4aac966ef6112f0b779521cf7686ae74
IGV_TASA=0.18

# Secreto JWT de la plataforma (Módulo C), distinto al de los estudios
JWT_PLATAFORMA_SECRET=0491e8269ffdc1de7c22dab5044cb5203fce192e0d813365f13f17d7f671c5d206fc32b035dc4c8959d3874f11a94971

# Exportaciones de reportes (cola en segundo plano)
REPORTES_DIR=./storage/reportes
REPORTES_WORKER_EMBEBIDO=true
